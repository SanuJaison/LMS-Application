{
  "info": {
    "name": "KIDE API — Full Test Suite",
    "description": "Every documented KIDE API for admin + mobile app. Run folders top to bottom.\n\n1) Auth: run Admin Login, SM Login. 2) Hierarchy: Create ASM, then ASM Login, Create BDE, then BDE Login. 3) App folders. 4) Admin folders.\n\nTokens are saved automatically into collection variables by the login requests.\n\nBase URL: http://localhost:3000 (change the baseUrl variable for production).\n\nNote: employee passwords are not persisted in the DB — employee logins accept password123 or kide1234.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminToken", "value": "" },
    { "key": "smToken", "value": "" },
    { "key": "asmToken", "value": "" },
    { "key": "bdeToken", "value": "" },
    { "key": "asmEmployeeId", "value": "" },
    { "key": "bdeEmployeeId", "value": "" },
    { "key": "asmDocId", "value": "" },
    { "key": "bdeDocId", "value": "" },
    { "key": "leadDocId", "value": "" },
    { "key": "leadId", "value": "" },
    { "key": "studentId", "value": "STU-004" },
    { "key": "wdrId", "value": "" },
    { "key": "salId", "value": "" },
    { "key": "recordId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', j.token || (j.data && j.data.token));",
                  "pm.test('admin login ok', function () { pm.expect(j.success).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@kide.com\",\"password\":\"password123\"}" },
            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "SM Login (SM001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('smToken', j.token || (j.data && j.data.token));",
                  "pm.test('sm login ok', function () { pm.expect(j.success).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"employee_id\":\"SM001\",\"password\":\"password123\"}" },
            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "ASM Login (uses asmEmployeeId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('asmToken', j.token || (j.data && j.data.token));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"employee_id\":\"{{asmEmployeeId}}\",\"password\":\"password123\"}" },
            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "BDE Login (uses bdeEmployeeId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('bdeToken', j.token || (j.data && j.data.token));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"employee_id\":\"{{bdeEmployeeId}}\",\"password\":\"password123\"}" },
            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"token\":\"{{adminToken}}\"}" },
            "url": "{{baseUrl}}/api/auth/refresh-token"
          }
        },
        {
          "name": "Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bdeToken}}" }],
            "url": "{{baseUrl}}/api/profile"
