            "header": [{ "key": "Authorization", "value": "Bearer {{bdeToken}}" }],
            "url": "{{baseUrl}}/api/logout"
          }
        },
        {
          "name": "Set Password (employee password is not persisted)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"employee_id\":\"{{bdeEmployeeId}}\",\"password\":\"newpass123\"}" },
            "url": "{{baseUrl}}/api/set-password"
          }
        }
      ]
    },
